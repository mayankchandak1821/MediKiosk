{
  "info": {
    "name": "MediKiosk API Collection",
    "description": "Postman Collection for MediKiosk Flask Backend APIs (Patient ABHA, Vitals Stream, OCR, Triage, and ABDM FHIR Export).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "2. Ingest Hardware Vitals",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"temperature_c\": 39.4,\n  \"heart_rate_bpm\": 110,\n  \"spo2_percent\": 87,\n  \"respiratory_rate\": 22,\n  \"source\": \"USB Thermometer / Pulse Ox\"\n}"
        },
        "url": {
